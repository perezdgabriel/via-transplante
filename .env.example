# Copiar a .env.local y completar con valores reales.

# Claude API
ANTHROPIC_API_KEY=
# Modelo: haiku para desarrollo/pruebas, cambiar a claude-sonnet-5 en producción.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Dominio propio de la app. El host tiene que ser EXACTAMENTE <slug>.<APP_DOMAIN>: sin esto,
# calvomackenna.attacker.com serviría el hospital Calvo Mackenna a quien apunte ese dominio al origen.
APP_DOMAIN=viatransplante.cl

# Hospitales (tenants). Un proyecto Supabase POR HOSPITAL: los datos de paciente nunca comparten base
# entre instituciones (ver docs/adr/0008-dos-planos-de-tenancy.md). La clave del objeto es el
# subdominio: "calvomackenna" atiende en calvomackenna.viatransplante.cl.
#
# Si falta o está mal formado, la app compila igual y responde 500 en TODAS las rutas: verificarlo es
# parte del despliegue.
#
# packageId elige el baseline clínico de lib/knowledge-base.ts. Hoy solo: trasplante_pediatrico.
# serviceKey es SOLO servidor y NUNCA llega al navegador (ver publicTenant() en lib/tenants.ts).
TENANTS_JSON={"hospital-demo":{"hospitalName":"Hospital Pediátrico Demo","unitName":"Unidad de Trasplante Hepático y Renal Pediátrico","packageId":"trasplante_pediatrico","supabaseUrl":"https://xxxx.supabase.co","anonKey":"","serviceKey":""}}

# SOLO desarrollo local: qué tenant atiende en localhost, que no tiene subdominio. Se ignora en
# cualquier host que no sea localhost, así que un despliegue real no puede activarlo por accidente.
TENANT_FALLBACK_SLUG=hospital-demo
